# Postgres
DATABASE_URL=postgres://user:pass@host:5432/whispertalk

# Stripe — start with test keys, swap to live when ready
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
# Optional: add-on price ID for additional license keys at $10 each. Omit to disable extras.
STRIPE_ADDITIONAL_PRICE_ID=price_xxx

# Resend (email delivery for license keys)
RESEND_API_KEY=re_xxx
EMAIL_FROM="WisperTalk <licenses@advancedmarketing.co>"

# License signing — generate with: openssl rand -base64 48
LICENSE_JWT_SECRET=replace-me-with-48-bytes-of-random

# Admin dashboard
ADMIN_PASSWORD=change-me
ADMIN_COOKIE_SECRET=replace-me-with-48-bytes-of-random

# Public
NEXT_PUBLIC_SITE_URL=https://wispertalk.com
NEXT_PUBLIC_DOWNLOAD_URL=https://github.com/bensblueprints/whisper-talk/releases/latest

# AppSumo integration
# Set this to a random secret, paste it into AppSumo dashboard → Webhook → Authorization header (Bearer)
APPSUMO_WEBHOOK_SECRET=replace-me-with-a-random-secret
# Price in cents AppSumo charges per license (2900 = $29)
APPSUMO_PRICE_CENTS=2900

# Whop integration — https://whop.com/dashboard → Settings → Webhooks
WHOP_API_KEY=apik_xxx
# Get this from Whop dashboard after creating the webhook endpoint
WHOP_WEBHOOK_SECRET=whsec_xxx
